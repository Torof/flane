{
  "name": "flane",
  "version": "0.0.2",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start",
    "android": "EXPO_NO_TELEMETRY=1 expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "spdx": "bash ../tools/dev/check-spdx.sh ..",
    "licenses": "node ../tools/dev/licenses.mjs .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run spdx && npm test"
  },
  "dependencies": {
    "expo": "58.0.16",
    "expo-constants": "58.0.12",
    "expo-dev-client": "58.0.14",
    "expo-linking": "58.0.13",
    "expo-router": "58.0.24",
    "expo-status-bar": "58.0.3",
    "expo-updates": "58.0.17",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "babel-preset-expo": "58.0.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "jest-expo": "58.0.11",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/",
      "/.expo/"
    ]
  }
}
