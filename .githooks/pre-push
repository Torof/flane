#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Flâne pre-push hook: all the local checks (npm run check: types, lint,
# formatting, SPDX notices, tests) before sending, as soon as the app exists
# (app/package.json). As long as it does not exist, does nothing.
set -u

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 1
if [ ! -f "$root/app/package.json" ]; then
  exit 0
fi

cd "$root/app" || exit 1

# Node: the version of .nvmrc. With nvm, it is activated here; otherwise we compare and explain.
wanted="$(tr -d '[:space:]' < .nvmrc)"
nvm_sh="${NVM_DIR:-$HOME/.nvm}/nvm.sh"
if [ -s "$nvm_sh" ]; then
  # shellcheck disable=SC1090
  . "$nvm_sh" >/dev/null 2>&1
  nvm use --silent "$wanted" >/dev/null 2>&1 || true
fi
current="$(node -v 2>/dev/null | sed 's/^v//')"
if [ "$current" != "$wanted" ]; then
  echo "pre-push: Node $wanted expected (app/.nvmrc), $current found. Run « nvm install $wanted » then « nvm use » in app/." >&2
  exit 1
fi
if [ ! -d node_modules ]; then
  echo "pre-push: app/node_modules missing. Run « npm ci » in app/." >&2
  exit 1
fi

npm run --silent check
