#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Hook pre-push Flâne : toutes les vérifications locales (npm run check :
# types, lint, formatage, notices SPDX, tests) avant d'envoyer, dès que l'appli
# existe (app/package.json). Tant qu'elle n'existe pas, ne fait rien.
set -u

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 1
if [ ! -f "$root/app/package.json" ]; then
  exit 0
fi

cd "$root/app" || exit 1

# Node : la version de .nvmrc. Avec nvm, on l'active ici ; sinon on compare et on explique.
wanted="$(tr -d '[:space:]' < .nvmrc)"
nvm_sh="${NVM_DIR:-$HOME/.nvm}/nvm.sh"
if [ -s "$nvm_sh" ]; then
  # shellcheck disable=SC1090
  . "$nvm_sh" >/dev/null 2>&1
  nvm use --silent "$wanted" >/dev/null 2>&1 || true
fi
current="$(node -v 2>/dev/null | sed 's/^v//')"
if [ "$current" != "$wanted" ]; then
  echo "pre-push : Node $wanted attendu (app/.nvmrc), $current trouvé. Lancer « nvm install $wanted » puis « nvm use » dans app/." >&2
  exit 1
fi
if [ ! -d node_modules ]; then
  echo "pre-push : app/node_modules absent. Lancer « npm ci » dans app/." >&2
  exit 1
fi

npm run --silent check
