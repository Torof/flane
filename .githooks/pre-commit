#!/usr/bin/env bash
# Hook pre-commit Flâne : recherche de secrets dans les fichiers indexés avec
# gitleaks (version épinglée dans tools/dev/setup.sh). En cas de doute, on
# refuse : gitleaks absent ou en erreur = commit refusé. Le secret lui-même
# n'est jamais affiché.
set -u

EXPECTED_VERSION="8.30.1"

find_gitleaks() {
  if command -v gitleaks >/dev/null 2>&1; then
    command -v gitleaks
  elif [ -x "${HOME:-/nonexistent}/.local/bin/gitleaks" ]; then
    printf '%s\n' "$HOME/.local/bin/gitleaks"
  fi
}

gitleaks_bin="$(find_gitleaks)"
if [ -z "$gitleaks_bin" ]; then
  cat >&2 <<EOF
pre-commit : gitleaks introuvable (ni dans le PATH, ni dans ~/.local/bin).
  Lancer tools/dev/setup.sh pour l'installer (version $EXPECTED_VERSION, somme de contrôle vérifiée).
  Commit refusé : la recherche de secrets est obligatoire.
EOF
  exit 1
fi

version="$("$gitleaks_bin" version 2>/dev/null | tr -d '[:space:]' | sed 's/^v//')"
if [ "$version" != "$EXPECTED_VERSION" ]; then
  echo "pre-commit : gitleaks $version détecté, $EXPECTED_VERSION attendue (avertissement, voir tools/dev/setup.sh)." >&2
fi

root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "pre-commit : pas dans un dépôt git. Commit refusé." >&2
  exit 1
}
cd "$root" || exit 1

# Une configuration gitleaks fournie par le dépôt neutraliserait la recherche :
# refusée, qu'elle soit indexée ou déjà présente. Une exception se discute et se
# consigne dans le journal ; elle ne se glisse pas dans un commit.
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if printf '%s\n' "$staged" | grep -Eq '(^|/)\.gitleaks(\.toml|ignore)$' \
  || [ -e .gitleaks.toml ] || [ -e .gitleaksignore ]; then
  echo "pre-commit : configuration gitleaks fournie par le dépôt (.gitleaks.toml ou .gitleaksignore). Commit refusé." >&2
  exit 1
fi
if git diff --cached -U0 -- . ':(exclude)docs' ':(exclude)*.md' | grep '^+' | grep -v '^+++' | grep -q 'gitleaks:''allow'; then
  echo "pre-commit : annotation d'exception gitleaks dans le code. Commit refusé : une exception se consigne dans le journal, pas dans le code." >&2
  exit 1
fi

report="$(mktemp)"
log="$(mktemp)"
trap 'rm -f "$report" "$log"' EXIT

env -u GITLEAKS_CONFIG "$gitleaks_bin" git --pre-commit --staged --redact --no-banner --log-level error \
  --exit-code 1 --report-format json --report-path "$report" >"$log" 2>&1
rc=$?

if [ "$rc" -eq 0 ]; then
  exit 0
fi

# Rapport non vide : des secrets ont été trouvés. Afficher la règle, le fichier
# et la ligne, jamais la valeur.
if [ -s "$report" ] && command -v python3 >/dev/null 2>&1; then
  findings="$(python3 -I - "$report" <<'PY'
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        results = json.load(f) or []
except Exception:
    results = []
for r in results:
    print(f"  règle {r.get('RuleID', '?')}, fichier {r.get('File', '?')}, ligne {r.get('StartLine', '?')}")
PY
)"
  if [ -n "$findings" ]; then
    cat >&2 <<EOF
pre-commit : secret détecté, commit refusé.
$findings
  Retirer le secret du fichier (et le révoquer s'il est réel). Aucune exception
  gitleaks : une exception se discute et se consigne dans le journal.
EOF
    exit 1
  fi
fi

echo "pre-commit : gitleaks a échoué (code $rc) sans résultat exploitable : doute, commit refusé." >&2
tail -n 5 "$log" >&2 || true
exit 1
