#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Flâne pre-commit hook: searches the staged files for secrets with gitleaks
# (version pinned in tools/dev/gitleaks.env). When in doubt, it refuses:
# gitleaks missing or in error = commit refused. The secret itself is never
# displayed.
set -u

root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "pre-commit: not in a git repository. Commit refused." >&2
  exit 1
}
cd "$root" || exit 1

GITLEAKS_VERSION=""
# shellcheck source=tools/dev/gitleaks.env
. tools/dev/gitleaks.env 2>/dev/null
EXPECTED_VERSION="$GITLEAKS_VERSION"
if [ -z "$EXPECTED_VERSION" ]; then
  echo "pre-commit: tools/dev/gitleaks.env unreadable or without GITLEAKS_VERSION. Commit refused." >&2
  exit 1
fi

find_gitleaks() {
  if command -v gitleaks >/dev/null 2>&1; then
    command -v gitleaks
  elif [ -x "${HOME:-/nonexistent}/.local/bin/gitleaks" ]; then
    printf '%s\n' "$HOME/.local/bin/gitleaks"
  fi
}

gitleaks_bin="$(find_gitleaks)"
if [ -z "$gitleaks_bin" ]; then
  cat >&2 <<EOF
pre-commit: gitleaks not found (neither in the PATH nor in ~/.local/bin).
  Run tools/dev/setup.sh to install it (version $EXPECTED_VERSION, checksum verified).
  Commit refused: the secret search is mandatory.
EOF
  exit 1
fi

version="$("$gitleaks_bin" version 2>/dev/null | tr -d '[:space:]' | sed 's/^v//')"
if [ "$version" != "$EXPECTED_VERSION" ]; then
  echo "pre-commit: gitleaks $version found, $EXPECTED_VERSION expected (warning, see tools/dev/setup.sh)." >&2
fi

# A gitleaks configuration provided by the repository would neutralise the search:
# refused, whether staged or already present. An exception is discussed and
# recorded in the journal; it does not slip into a commit.
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if printf '%s\n' "$staged" | grep -Eq '(^|/)\.gitleaks(\.toml|ignore)$' \
  || [ -e .gitleaks.toml ] || [ -e .gitleaksignore ]; then
  echo "pre-commit: gitleaks configuration provided by the repository (.gitleaks.toml or .gitleaksignore). Commit refused." >&2
  exit 1
fi
if git diff --cached -U0 | grep '^+' | grep -v '^+++' | grep -q 'gitleaks:''allow'; then
  echo "pre-commit: gitleaks exception annotation in the code. Commit refused: an exception is recorded in the journal, not in the code." >&2
  exit 1
fi

report="$(mktemp)"
log="$(mktemp)"
trap 'rm -f "$report" "$log"' EXIT

env -u GITLEAKS_CONFIG "$gitleaks_bin" git --pre-commit --staged --redact --no-banner --log-level error \
  --exit-code 1 --report-format json --report-path "$report" >"$log" 2>&1
rc=$?

if [ "$rc" -eq 0 ]; then
  exit 0
fi

# Non-empty report: secrets were found. Show the rule, the file and the line,
# never the value.
if [ -s "$report" ] && command -v python3 >/dev/null 2>&1; then
  findings="$(python3 -I - "$report" <<'PY'
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        results = json.load(f) or []
except Exception:
    results = []
for r in results:
    print(f"  rule {r.get('RuleID', '?')}, file {r.get('File', '?')}, line {r.get('StartLine', '?')}")
PY
)"
  if [ -n "$findings" ]; then
    cat >&2 <<EOF
pre-commit: secret detected, commit refused.
$findings
  Remove the secret from the file (and revoke it if it is real). No gitleaks
  exception: an exception is discussed and recorded in the journal.
EOF
    exit 1
  fi
fi

echo "pre-commit: gitleaks failed (code $rc) without a usable result: in doubt, commit refused." >&2
tail -n 5 "$log" >&2 || true
exit 1
