#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Flâne commit-msg hook: the title must describe the change in plain English
# (docs/METHOD.md), so it only checks that a title exists and fits in 72
# characters. Merge messages from git or GitHub and « Revert » always pass.
set -u

file="${1:-}"
if [ -z "$file" ] || [ ! -r "$file" ]; then
  echo "commit-msg: message file not found. Commit refused." >&2
  exit 1
fi

# First useful line: neither a comment nor blank.
subject="$(grep -v '^#' "$file" | grep -m1 -v '^[[:space:]]*$' || true)"

if printf '%s' "$subject" | grep -Eq '^(Revert "|Merge (branch|pull request #[0-9]+) )'; then
  exit 0
fi

length="$(printf '%s' "$subject" | LC_ALL=C.UTF-8 wc -m)"
if [ -n "$subject" ] && [ "$length" -le 72 ]; then
  exit 0
fi

cat >&2 <<MSG
commit-msg: message refused.
  Got     : ${subject:-(empty)}
  Expected: a title of 72 characters at most saying what changes, in plain English.
  Example : Stop signals also catch "véto" and quoted stops
  See docs/METHOD.md. Hooks are never bypassed.
MSG
exit 1
