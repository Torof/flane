{
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/google-services.json)",
      "Read(./node_modules/**)",
      "Read(./android/app/build/**)",
      "Read(./data-pipeline/out/**)"
    ],
    "ask": [
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./.githooks/**)",
      "Write(./.githooks/**)",
      "Edit(./.github/**)",
      "Write(./.github/**)",
      "Edit(./tools/dev/**)",
      "Write(./tools/dev/**)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Edit(./.gitignore)",
      "Write(./.gitignore)",
      "Edit(./.mcp.json)",
      "Write(./.mcp.json)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch --list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git merge-base:*)",
      "Bash(git remote -v)",
      "Bash(git fetch:*)",
      "Bash(git stash list)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git switch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh label list:*)",
      "Bash(bash tools/dev/test-hooks.sh:*)",
      "Bash(bash tools/dev/setup.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/garde-branche-main.sh\""
          }
        ]
      }
    ]
  }
}
